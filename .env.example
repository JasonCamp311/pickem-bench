# Copy to .env. Models whose provider has no credentials are skipped, not failed.
OPENROUTER_API_KEY=
# Ollama listens on loopback on fedora. From Windows, tunnel first:
#   ssh -N -L 11435:127.0.0.1:11434 fedora
# and set OLLAMA_HOST=http://127.0.0.1:11435. On fedora itself the default works.
OLLAMA_HOST=http://127.0.0.1:11434
# Optional: an ntfy topic URL that hears about failed unattended runs.
PICKEM_NTFY=
